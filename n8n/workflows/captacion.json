    {
      "id": "a4b10e81-d239-4d1d-a557-289cd6df3d4c",
      "name": "Validar evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Valida el evento que envía la API después del registro de P01 (ADR-16, HU0002-1.0): el cuerpo es solo\n// { id_expediente } con un entero mayor que 0. Cualquier otro campo lo invalida: el contrato lleva solo\n// identificadores, así las ejecuciones guardan menos datos personales (C10, C11).\nconst esObjeto = (valor) => valor !== null && typeof valor === 'object' && !Array.isArray(valor);\n\nreturn $input.all().map((item, indice) => {\n  const cuerpo = esObjeto(item.json?.body) ? item.json.body : null;\n  const claves = cuerpo ? Object.keys(cuerpo) : [];\n  const id = cuerpo?.id_expediente;\n  const valido = claves.length === 1 && claves[0] === 'id_expediente' && Number.isSafeInteger(id) && id > 0 && id <= 2147483647;\n  return { json: { valido, id_expediente: valido ? id : null }, pairedItem: { item: indice } };\n});"
      }
    },
