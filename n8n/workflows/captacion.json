    {
      "id": "234dbc22-9d07-42c2-9529-76a9ae189bbd",
      "name": "Clasificar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Decide qué hace captacion con lo que devolvió notificacion-multicanal (HU0002-1.0 y 2.0, C9, D7 corregido).\n// Entrada: un ítem por carpeta, emparejado con su reserva de la salida «reservada» de «¿Reserva hecha?» por el\n// pairedItem que pone Execute Workflow (el subflujo corre una vez por ítem); si falta, por la posición. Es el\n// resultado del subflujo, { id_expediente, correo: { estado_envio, id_notificacion }, whatsapp }, o, si falló,\n// { error: \"<mensaje>\" } (Execute Workflow que continúa ante errores, n8n 2.42.5).\n//   enviado   <- correo.estado_envio = enviado                                     -> termina\n//   rebote    <- correo.estado_envio = fallido: con la carpeta reservada, notificacion-multicanal solo responde\n//                fallido ante el rechazo permanente del destinatario (D1) y deja la fila pendiente\n//                                                  -> POST /rebote la cierra (HU0002-2.0); si falla, la retoma el barrido\n//   fallido   <- error 400 «notificacion-multicanal: entrada inválida…»: un defecto, la entrada la arma la API\n//                                                                                -> PATCH fallido, sin reintento\n//   pendiente <- correo.estado_envio = pendiente (error técnico de SMTP, o un 5.7.x u otro 5xx que no es rebote),\n//                un 502, un 500 o cualquier otro error\n//                                                                                -> sin PATCH: la retoma el barrido\n// Lo que no se reconoce cae en pendiente: un mensaje desconocido nunca deja la carpeta sin reintento.\nconst ENTRADA_INVALIDA = 'notificacion-multicanal: entrada inválida';\nconst reservas = $('¿Reserva hecha?').all(0);\n\nconst clasificar = (resultado) => {\n  if (resultado.error !== undefined) {\n    const mensaje = typeof resultado.error === 'string' ? resultado.error : String(resultado.error?.message ?? '');\n    return mensaje.startsWith(ENTRADA_INVALIDA)\n      ? { accion: 'fallido', motivo: 'entrada_invalida' }\n      : { accion: 'pendiente', motivo: 'notificacion_no_disponible' };\n  }\n  switch (resultado.correo?.estado_envio) {\n    case 'enviado':\n      return { accion: 'enviado', motivo: 'enviado' };\n    case 'fallido':\n      return { accion: 'rebote', motivo: 'rechazo_destinatario' };\n    case 'pendiente':\n      return { accion: 'pendiente', motivo: 'smtp_pendiente' };\n    default:\n      return { accion: 'pendiente', motivo: 'resultado_desconocido' };\n  }\n};\n\nreturn $input.all().map((item, indice) => {\n  const reserva = reservas[item.pairedItem?.item ?? indice]?.json?.body ?? {};\n  return {\n    json: {\n      ...clasificar(item.json ?? {}),\n      id_expediente: reserva.id_expediente ?? null,\n      id_notificacion: reserva.id_notificacion ?? null,\n    },\n    pairedItem: { item: indice },\n  };\n});"
      }
    },
