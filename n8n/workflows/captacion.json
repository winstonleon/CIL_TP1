    {
      "id": "385321f1-36e3-4303-9bea-f2d945155787",
      "name": "Un ítem por expediente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Barrido de captacion (C27, HU0002-1.0): un ítem por cada expediente de GET /internal/captacion/pendientes\n// (prospectos sin carpeta registrados hace más de 1 min y carpetas pendientes intentadas hace más de 10 min).\n// Si no hay pendientes no sale ningún ítem y la ejecución termina aquí.\nconst salida = [];\n$input.all().forEach((item, indice) => {\n  const expedientes = Array.isArray(item.json?.expedientes) ? item.json.expedientes : [];\n  for (const e of expedientes) {\n    if (Number.isSafeInteger(e?.id_expediente) && e.id_expediente > 0) {\n      salida.push({ json: { id_expediente: e.id_expediente }, pairedItem: { item: indice } });\n    }\n  }\n});\nreturn salida;"
      }
    },
