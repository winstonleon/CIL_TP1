    {
      "id": "398f2e1e-7599-4b08-9545-c9f14419d688",
      "name": "Clasificar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Decide qué hace seguimiento-recordatorios con lo que devolvió notificacion-multicanal para cada recordatorio de la\n// visita (HU0003-1.0, D4). Sigue ADR-07 «Fallos de los avisos de la visita»: la clasificación de D7, sin rebote ni\n// transición (P-j); es la misma lógica de «Clasificar resultado» de agendamiento.\n// Entrada: un ítem por aviso, emparejado con su reserva de la salida «reservado» de «¿Reserva hecha?» por el pairedItem\n// que pone Execute Workflow (el subflujo corre una vez por ítem); si falta, por la posición. Es el resultado del\n// subflujo, { id_expediente, correo: { estado_envio, id_notificacion }, whatsapp }, o, si falló, { error: \"<mensaje>\" }\n// (Execute Workflow con onError continueRegularOutput, C9).\n//   enviado   <- correo.estado_envio = enviado: el subflujo ya cerró la fila                    -> termina\n//   fallido   <- correo.estado_envio = fallido: rechazo permanente del destinatario; con la fila reservada el subflujo\n//                no la cierra                      (motivo rechazo_destinatario) -> PATCH fallido y termina sin error\n//             <- error «notificacion-multicanal: entrada inválida…» (400): un defecto, la entrada la arma la API\n//                                                  (motivo entrada_invalida)     -> PATCH fallido y Stop and Error\n//   pendiente <- correo.estado_envio = pendiente (error técnico de SMTP, o un 5xx que no es rechazo permanente), un 502,\n//                un 500 o cualquier otro error: resultado desconocido (R22), nunca se marca fallido\n//                                                  -> sin PATCH y Stop and Error; el barrido lo retoma a los 10 min\n//                                                     con un intento nuevo (una fila por intento, ADR-07)\n// Lo que no se reconoce cae en pendiente.\n// A3 (D3): la salida lleva solo la acción, el motivo y los ids de la cita, el expediente y la notificación. Nunca el\n// asunto ni el cuerpo de la reserva, ni el mensaje del error del subflujo.\nconst ENTRADA_INVALIDA = 'notificacion-multicanal: entrada inválida';\nconst reservas = $('¿Reserva hecha?').all(0);\n\nconst clasificar = (resultado) => {\n  if (resultado.error !== undefined) {\n    const mensaje = typeof resultado.error === 'string' ? resultado.error : String(resultado.error?.message ?? '');\n    return mensaje.startsWith(ENTRADA_INVALIDA)\n      ? { accion: 'fallido', motivo: 'entrada_invalida' }\n      : { accion: 'pendiente', motivo: 'notificacion_no_disponible' };\n  }\n  switch (resultado.correo?.estado_envio) {\n    case 'enviado':\n      return { accion: 'enviado', motivo: 'enviado' };\n    case 'fallido':\n      return { accion: 'fallido', motivo: 'rechazo_destinatario' };\n    case 'pendiente':\n      return { accion: 'pendiente', motivo: 'smtp_pendiente' };\n    default:\n      return { accion: 'pendiente', motivo: 'resultado_desconocido' };\n  }\n};\n\nreturn $input.all().map((item, indice) => {\n  const reserva = reservas[item.pairedItem?.item ?? indice]?.json?.body ?? {};\n  return {\n    json: {\n      ...clasificar(item.json ?? {}),\n      id_cita: reserva.id_cita ?? null,\n      id_expediente: reserva.id_expediente ?? null,\n      id_notificacion: reserva.id_notificacion ?? null,\n    },\n    pairedItem: { item: indice },\n  };\n});"
      }
    },
