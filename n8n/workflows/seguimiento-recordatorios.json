    {
      "id": "01b5c3a3-f7c1-4fbc-b818-675a5689e982",
      "name": "Un ítem por cita",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Recordatorio de la visita (HU0003-1.0, D4, ADR-16 «seguimiento-recordatorios»): un ítem por cada cita de\n// GET /internal/recordatorios/pendientes (citas reservadas dentro de la ventana [fecha_hora − RECORDATORIO_VISITA_HORAS,\n// fecha_hora) sin recordatorio, y recordatorios cuyo último intento lleva más de 10 min pendiente). Sin nodos Wait: el\n// recordatorio queda «programado» por los datos. Si no hay pendientes no sale ningún ítem y la ejecución termina aquí.\n// Solo lleva id_cita (A3).\nconst salida = [];\n$input.all().forEach((item, indice) => {\n  const citas = Array.isArray(item.json?.citas) ? item.json.citas : [];\n  for (const c of citas) {\n    if (Number.isSafeInteger(c?.id_cita) && c.id_cita > 0 && c.id_cita <= 2147483647) {\n      salida.push({ json: { id_cita: c.id_cita }, pairedItem: { item: indice } });\n    }\n  }\n});\nreturn salida;"
      }
    },
