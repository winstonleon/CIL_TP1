    {
      "id": "916773f7-1423-4bbd-bfa8-85bbccf178d2",
      "name": "Un ítem por expediente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Barrido de generacion-carta (ADR-16, C27; HU0016-1.0): un ítem por cada expediente de GET /internal/cartas/pendientes\n// (cuota acreditada o vacante sin cuota, sin carta o con el aviso de la carta pendiente hace más de 10 min). Recupera la\n// carta cuando el evento del webhook no llegó o el aviso quedó pendiente. Si no hay pendientes no sale ningún ítem y la\n// ejecución termina aquí. Solo lleva id_expediente.\nconst salida = [];\n$input.all().forEach((item, indice) => {\n  const expedientes = Array.isArray(item.json?.expedientes) ? item.json.expedientes : [];\n  for (const e of expedientes) {\n    if (Number.isSafeInteger(e?.id_expediente) && e.id_expediente > 0 && e.id_expediente <= 2147483647) {\n      salida.push({ json: { id_expediente: e.id_expediente }, pairedItem: { item: indice } });\n    }\n  }\n});\nreturn salida;"
      }
    },
