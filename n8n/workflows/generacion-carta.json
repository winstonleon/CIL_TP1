    {
      "id": "d973da23-127c-40f3-b288-a89db85688c6",
      "name": "Validar evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Valida el evento que envía la API cuando la cuota de ingreso queda acreditada (HU0016-1.0), según ADR-16\n// «Receptor generacion-carta»: el cuerpo es exactamente { id_expediente } con un entero de 1 a 2147483647. Cualquier\n// otro campo lo invalida: el contrato lleva solo identificadores (C10, C11). La salida lleva solo { valido, id_expediente }.\nconst esObjeto = (valor) => valor !== null && typeof valor === 'object' && !Array.isArray(valor);\n\nreturn $input.all().map((item, indice) => {\n  const cuerpo = esObjeto(item.json?.body) ? item.json.body : null;\n  const claves = cuerpo ? Object.keys(cuerpo) : [];\n  const id = cuerpo?.id_expediente;\n  const valido = claves.length === 1 && claves[0] === 'id_expediente' && Number.isSafeInteger(id) && id > 0 && id <= 2147483647;\n  return { json: { valido, id_expediente: valido ? id : null }, pairedItem: { item: indice } };\n});"
      }
    },
