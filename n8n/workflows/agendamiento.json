    {
      "id": "dc4125b5-0d06-4974-95de-890f46630ac7",
      "name": "Validar evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Valida el evento que envía la API después de la reserva en P02 (HU0003-1.0) y del registro de la asistencia en G04\n// (HU0004-1.0 «Asistió - Interesado» y HU0004-2.0 «No asistió»), según ADR-16 «Receptor agendamiento»: el cuerpo es\n// exactamente { id_cita } con un entero de 1 a 2147483647. Cualquier otro campo lo invalida: el contrato lleva solo\n// identificadores (C10, C11). La salida lleva solo { valido, id_cita } (A3, D3).\nconst esObjeto = (valor) => valor !== null && typeof valor === 'object' && !Array.isArray(valor);\n\nreturn $input.all().map((item, indice) => {\n  const cuerpo = esObjeto(item.json?.body) ? item.json.body : null;\n  const claves = cuerpo ? Object.keys(cuerpo) : [];\n  const id = cuerpo?.id_cita;\n  const valido = claves.length === 1 && claves[0] === 'id_cita' && Number.isSafeInteger(id) && id > 0 && id <= 2147483647;\n  return { json: { valido, id_cita: valido ? id : null }, pairedItem: { item: indice } };\n});"
      }
    },
