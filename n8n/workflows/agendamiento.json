    {
      "id": "1daa7a05-d464-4fe1-9219-b6271c6b01c5",
      "name": "Un ítem por cita",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Barrido de agendamiento (ADR-16, S12): un ítem por cada cita de GET /internal/agendamiento/pendientes (avisos del\n// estado actual de la cita sin notificación con más de 1 min, y avisos cuyo último intento lleva más de 10 min\n// pendiente). Recupera la confirmación (HU0003-1.0), las credenciales (HU0004-1.0) y la invitación a reprogramar\n// (HU0004-2.0) cuando el evento del webhook no llegó o el intento quedó pendiente. Si no hay pendientes no sale ningún\n// ítem y la ejecución termina aquí. Solo lleva id_cita (A3).\nconst salida = [];\n$input.all().forEach((item, indice) => {\n  const citas = Array.isArray(item.json?.citas) ? item.json.citas : [];\n  for (const c of citas) {\n    if (Number.isSafeInteger(c?.id_cita) && c.id_cita > 0 && c.id_cita <= 2147483647) {\n      salida.push({ json: { id_cita: c.id_cita }, pairedItem: { item: indice } });\n    }\n  }\n});\nreturn salida;"
      }
    },
