    {
      "id": "496b0581-d0fa-4e77-86ba-a36580cb7a26",
      "name": "Normalizar y validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        110
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normaliza y valida la entrada (webhook o llamada desde otro flujo) contra el contrato de notificación. Sprint 0 (S0-C), flujo notificacion-multicanal; HU0002 agrega id_notificacion.\n// Contrato: { id_expediente: entero > 0, tipo_evento: texto de 1 a 60 caracteres, asunto: texto no vacío, cuerpo: texto plano no vacío, id_notificacion?: entero > 0 }.\n// id_notificacion es opcional y solo vale en la llamada desde otro flujo (la carpeta de captacion, HU0002): con él, el\n// envío exitoso cierra esa notificación ya reservada en lugar de registrar una nueva. El webhook lo ignora, así quien\n// tenga el secreto del webhook no puede cerrar notificaciones por id. El flujo no redacta mensajes: asunto y cuerpo\n// vienen del llamador.\n\nconst esObjeto = (valor) => valor !== null && typeof valor === 'object' && !Array.isArray(valor);\nconst esTextoNoVacio = (valor) => typeof valor === 'string' && valor.trim().length > 0;\n\nreturn $input.all().map((item, indice) => {\n  const json = esObjeto(item.json) ? item.json : {};\n  // El Webhook entrega el JSON del POST dentro de `body` (junto a headers, params y query);\n  // el Execute Workflow Trigger entrega los campos directamente.\n  const vieneDelWebhook = esObjeto(json.headers) && 'body' in json;\n  const entrada = vieneDelWebhook ? (esObjeto(json.body) ? json.body : {}) : json;\n\n  const errores = [];\n\n  const idExpediente = entrada.id_expediente;\n  if (!Number.isSafeInteger(idExpediente) || idExpediente <= 0) {\n    errores.push('id_expediente debe ser un entero mayor que 0');\n  }\n\n  const tipoEvento = typeof entrada.tipo_evento === 'string' ? entrada.tipo_evento.trim() : '';\n  if (tipoEvento.length < 1 || tipoEvento.length > 60) {\n    errores.push('tipo_evento debe ser un texto de 1 a 60 caracteres');\n  }\n\n  if (!esTextoNoVacio(entrada.asunto)) {\n    errores.push('asunto debe ser un texto no vacío');\n  }\n\n  if (!esTextoNoVacio(entrada.cuerpo)) {\n    errores.push('cuerpo debe ser un texto no vacío');\n  }\n\n  const idNotificacion = vieneDelWebhook ? undefined : entrada.id_notificacion;\n  const conReserva = idNotificacion !== undefined && idNotificacion !== null;\n  if (conReserva && (!Number.isSafeInteger(idNotificacion) || idNotificacion <= 0)) {\n    errores.push('id_notificacion, si se envía, debe ser un entero mayor que 0');\n  }\n\n  const valido = errores.length === 0;\n  return {\n    json: {\n      valido,\n      errores,\n      id_expediente: valido ? idExpediente : null,\n      tipo_evento: valido ? tipoEvento : null,\n      asunto: valido ? entrada.asunto.trim() : null,\n      cuerpo: valido ? entrada.cuerpo : null,\n      id_notificacion: valido && conReserva ? idNotificacion : null,\n    },\n    pairedItem: { item: indice },\n  };\n});"
      }
    },
