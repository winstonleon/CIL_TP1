    {
      "id": "9404c78c-b4a9-4812-90f4-ab2b3d3dc2dd",
      "name": "Estado fallido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Estado del correo cuando el envío falló (Sprint 0, S0-C; HU0002-2.0 y D7).\n// Sin id_notificacion (las llamadas del Sprint 0) todo fallo es `fallido`, como siempre.\n// Con id_notificacion (la carpeta que reservó captacion) solo es rebote el rechazo del destinatario (RCPT; nodemailer:\n// «all recipients were rejected») con código extendido 5.1.x o 5.2.x, o con 550, 551 o 553 sin código extendido\n// (decisión de John, 26/10/2026):\n//   - rebote -> `fallido` en la respuesta, pero la fila NO se cierra aquí: la cierra captacion con POST /rebote, en la\n//     misma transacción que notificacion_rebotada y la transición (HU0002-2.0; D1). Si /rebote falla, la fila sigue\n//     pendiente y el barrido la retoma;\n//   - un 5.7.x (política del servidor), cualquier otro 5xx o un error técnico (conexión, DNS, timeout, 4xx temporal)\n//     -> `pendiente`: no se cierra, captacion lo deja en registro-errores y el barrido la retoma a los 10 min.\n// El texto del error solo se lee para clasificarlo; no pasa a la salida, porque puede traer la dirección de correo.\nconst entrada = $('Normalizar y validar entrada').item.json;\nconst error = $json.error;\nconst texto = [typeof error === 'string' ? error : error?.message, error?.description]\n  .filter((t) => typeof t === 'string')\n  .join(' ');\nconst RECHAZO_DESTINATARIO = /recipients? (were )?rejected|recipient address rejected/i;\n// Código básico 5xx y, si lo sigue, el extendido (p. ej. «550 5.1.0», «550-5.1.1» o «554 5.7.1»).\nconst codigo = /\\b(5\\d\\d)(?:[ -]5\\.(\\d{1,3})\\.\\d{1,3})?\\b/.exec(texto);\nconst esRebote = (c) => (c[2] !== undefined ? c[2] === '1' || c[2] === '2' : ['550', '551', '553'].includes(c[1]));\nconst rechazo = RECHAZO_DESTINATARIO.test(texto) && codigo !== null && esRebote(codigo);\nconst conReserva = entrada.id_notificacion !== null;\n\nreturn {\n  json: {\n    id_expediente: entrada.id_expediente,\n    tipo_evento: entrada.tipo_evento,\n    canal: 'correo',\n    estado_envio: !conReserva || rechazo ? 'fallido' : 'pendiente',\n  },\n};"
      }
    },
