    {
      "id": "948dcbc0-6669-4433-886f-b41ada721699",
      "name": "Un ítem por expediente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Barrido de recepcion-registro (ADR-16, C27): un ítem por cada expediente de GET /internal/completitud/pendientes\n// (confirmaciones de documentos sin verificar de hace más de 1 min, y avisos de faltantes cuyo último intento lleva más de\n// 10 min pendiente). Recupera la verificación de completitud (HU0017-1.0 y HU0017-2.0) cuando el evento del webhook no\n// llegó o el aviso quedó pendiente. Si no hay pendientes no sale ningún ítem y la ejecución termina aquí. Solo lleva\n// id_expediente.\nconst salida = [];\n$input.all().forEach((item, indice) => {\n  const expedientes = Array.isArray(item.json?.expedientes) ? item.json.expedientes : [];\n  for (const e of expedientes) {\n    if (Number.isSafeInteger(e?.id_expediente) && e.id_expediente > 0 && e.id_expediente <= 2147483647) {\n      salida.push({ json: { id_expediente: e.id_expediente }, pairedItem: { item: indice } });\n    }\n  }\n});\nreturn salida;"
      }
    },
    {
      "id": "be98046e-44d3-454f-aa48-75203dc8ff16",
      "name": "Expediente recibido",
      "notes": "Punto de convergencia del webhook y del barrido: ambos pasan solo { id_expediente } a «Verificar completitud».",
      "type": "n8n-nodes-base.noOp",
