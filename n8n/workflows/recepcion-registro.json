        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ flujo: $json.flujo, nodo: $json.nodo, id_ejecucion: $json.id_ejecucion }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "cil-api-interna"
        }
      }
    }
