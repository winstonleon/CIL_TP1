    {
      "id": "cb1999d8-8cf7-4185-9d1b-abdde4a959bb",
      "name": "Validar evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Valida el evento que envía la API después de «Confirmar documentos» en P06 (HU0017-1.0 y HU0017-2.0), según ADR-16\n// «Receptor recepcion-registro»: el cuerpo es exactamente { id_expediente } con un entero de 1 a 2147483647. Cualquier\n// otro campo lo invalida: el contrato lleva solo identificadores (C10, C11). La salida lleva solo { valido, id_expediente }.\nconst esObjeto = (valor) => valor !== null && typeof valor === 'object' && !Array.isArray(valor);\n\nreturn $input.all().map((item, indice) => {\n  const cuerpo = esObjeto(item.json?.body) ? item.json.body : null;\n  const claves = cuerpo ? Object.keys(cuerpo) : [];\n  const id = cuerpo?.id_expediente;\n  const valido = claves.length === 1 && claves[0] === 'id_expediente' && Number.isSafeInteger(id) && id > 0 && id <= 2147483647;\n  return { json: { valido, id_expediente: valido ? id : null }, pairedItem: { item: indice } };\n});"
      }
    },
    {
      "id": "c76aad4d-de1c-410e-8a49-bc5109cdc41d",
      "name": "¿Evento válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "7e22ff2b-338e-412a-9ced-b6713452c81e",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": false,
        "options": {}
      }
    },
    {
