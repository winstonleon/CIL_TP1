        }
      }
    },
    {
      "id": "ac1d491a-391c-48d9-931d-650d81e5142c",
      "name": "Fallo al verificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Rama de error de «Verificar completitud» (HU0017-2.0, C2): cuando el subflujo verificacion-completitud falla para un\n// expediente, el barrido sigue con los demás y este nodo prepara el registro del fallo. Emite solo los identificadores\n// que admite POST /internal/errores-flujo: el flujo, el nodo y el id de esta ejecución. NO lee el ítem de entrada: trae el\n// mensaje del error, que puede traer datos personales. Un ítem de salida por cada expediente que falló.\nconst id = String($execution?.id ?? '');\nconst id_ejecucion = /^[0-9A-Za-z-]{1,40}$/.test(id) ? id : 'sin-id';\n\nreturn $input.all().map((_item, indice) => ({\n  json: { flujo: 'recepcion-registro', nodo: 'Verificar completitud', id_ejecucion },\n  pairedItem: { item: indice },\n}));"
      }
    },
    {
      "id": "433fe340-86fb-4f19-9206-1738cfe06306",
      "name": "Registrar fallo en la API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "retryOnFail": true,
      "maxTries": 3,
