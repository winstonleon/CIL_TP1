    {
      "id": "a91f3ce3-e160-44b5-b50c-8ede675da912",
      "name": "Verificar completitud",
      "notes": "onError continueErrorOutput: un expediente que falla no frena a los demás del barrido y su fallo se registra en la API por la salida 1 (no se usa continueRegularOutput: la ejecución terminaría sin error y registro-errores no se dispararía).",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "onError": "continueErrorOutput",
      "position": [
        1200,
        120
      ],
      "parameters": {
