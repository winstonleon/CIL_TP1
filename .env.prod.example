# Valores de producción (VPS, docker-compose.prod.yml). No es un .env completo.
# En el servidor: copia .env.example a .env, reemplaza en él las variables de este archivo (agrega las que no estén)
# y corre `node scripts/generar-secretos.js` para generar los secretos. Pasos completos: GUIA-INSTALACION.md, sección 10.
# El resto de .env.example vale igual en producción. Las variables de puertos del host (POSTGRES_HOST_PORT,
# KEYCLOAK_HOST_PORT, N8N_HOST_PORT, FRONTEND_HOST_PORT, MAILPIT_UI_PORT) y KEYCLOAK_TEST_USER_PASSWORD son solo de dev.

# --- Dominio público ---
# HTTPS es obligatorio: el ingreso (OIDC con PKCE) solo funciona en un contexto seguro del navegador.
FRONTEND_PUBLIC_URL=https://admision.ejemplo.edu.pe
# Keycloak va detrás de NGINX, bajo /auth. La API lo alcanza por la red interna, también bajo /auth.
KEYCLOAK_PUBLIC_URL=https://admision.ejemplo.edu.pe/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth

# --- NGINX ---
# Carpeta del servidor con el certificado TLS: fullchain.pem y privkey.pem.
TLS_CERT_DIR=/etc/cil/tls
# Carpeta del servidor donde certbot deja la validación de Let's Encrypt (certbot --webroot).
ACME_WEBROOT_DIR=/var/www/cil-acme
# Puertos que publica NGINX. Opcionales: sin definir, 80 y 443.
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# --- Respaldo diario (ADR-08, C35; GUIA-INSTALACION.md, §10) ---
# Carpeta del servidor donde quedan los respaldos cifrados, fuera del repo. Se conservan 14 días y nunca menos de 7.
RESPALDO_DIR=/var/backups/cil
# Clave PÚBLICA de age (empieza con age1) para la que se cifran los respaldos. La privada se genera y se guarda FUERA del
# servidor, en la máquina del responsable:  age-keygen -o clave-respaldo-cil.txt  (la línea «public key:» va aquí).
# Sin definir, docker compose no arranca.
RESPALDO_CLAVE_PUBLICA=

# --- Correo (C12) ---
# SMTP real del proveedor que elija el colegio. Sin él no sale ningún correo: ni los de n8n ni los de Keycloak (enlace
# para definir la contraseña del personal y recuperación de contraseña). 587 con SMTP_STARTTLS=true, o 465 con SMTP_SSL=true.
# El realm de Keycloak toma estos valores solo al importarse la primera vez: después se cambian como dice
# GUIA-INSTALACION.md (sección 10). La contraseña no debe llevar «${».
SMTP_HOST=smtp.proveedor.example
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=true
# El remitente tiene que ser un buzón que alguien revise: a él llegan los correos de devolución, que el sistema no detecta (C34).
SMTP_FROM="Admisión CIL <admision@ejemplo.edu.pe>"
KEYCLOAK_SMTP_FROM=admision@ejemplo.edu.pe

# --- n8n ---
# Clave de la API de n8n que usa el contenedor `admin` (n8n:credenciales y n8n:importar). Se crea una sola vez en el
# editor de n8n (GUIA-INSTALACION.md, sección 10). Hasta entonces queda vacía: db:migrate no la necesita.
N8N_CIL_API_KEY=
