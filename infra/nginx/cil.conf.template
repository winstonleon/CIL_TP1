# NGINX de producción (ADR-08): termina TLS, sirve el build de Vue y reenvía /api (C19, C46) y /auth (Keycloak).
# Es el único contenedor que publica puertos (80 y 443) y no tiene ninguna ruta hacia n8n (C11).
# La imagen lo procesa con envsubst al arrancar: solo reemplaza ${FRONTEND_PUBLIC_URL} y ${API_PORT}, que son variables de
# entorno del contenedor. Las variables de NGINX ($host, $uri, $remote_addr...) quedan como están.

# Registro de acceso sin la consulta (?...) y sin el Referer (C19): ahí viajan el enlace de P02
# (/visita-guiada?t=<token>, que no vence) y el código de OIDC (/callback/...?code=...).
map $request_uri $ruta_sin_consulta {
    default             $request_uri;
    ~^(?<ruta>[^?]*)\?  $ruta;
}
log_format cil '$remote_addr [$time_local] "$request_method $ruta_sin_consulta $server_protocol" '
               '$status $body_bytes_sent $request_time "$http_user_agent"';

server_tokens off;

# Los destinos se resuelven con el DNS interno de Docker en cada petición (por eso van en variables): si `api` o
# `keycloak` se recrean y cambian de IP, NGINX los encuentra sin reiniciarse.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;
    access_log /var/log/nginx/access.log cil;

    # Validación de dominio de Let's Encrypt (certbot --webroot), sin detener NGINX.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    # Todo lo demás va a HTTPS: el ingreso (OIDC con PKCE) solo funciona en un contexto seguro del navegador.
    location / {
        return 301 ${FRONTEND_PUBLIC_URL}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;
    access_log /var/log/nginx/access.log cil;

    # El certificado se lee de una carpeta del servidor (TLS_CERT_DIR). Al renovarlo basta `nginx -s reload`.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;

    # --- /api/internal/* es solo para n8n, por la red interna (ADR-04, C19): no se publica. ---
    # Sin distinguir mayúsculas, porque Express tampoco las distingue. NGINX compara la ruta ya normalizada
    # (decodificada, sin «//» ni «/./»), así que /api//internal, /api/./internal y /api/%69nternal también caen aquí.
    location ~* ^/api/internal(/|$) {
        return 404;
    }

    # --- n8n no se publica (C11): sus webhooks y su editor solo existen en la red interna. ---
    # Ninguna regla de este archivo apunta a n8n; esta lo deja explícito (sin ella, estas rutas devolverían la
    # página de inicio del frontend).
    location ~* ^/webhook(-test|-waiting)?(/|$) {
        return 404;
    }

    # --- API: /api/<ruta> llega a la API como /<ruta> ---
    location /api/ {
        # 10 MB del archivo más los campos del formulario (C46). El tope por defecto, 1 MB, cortaría las cargas con 413.
        client_max_body_size 11m;
        set $destino_api http://api:${API_PORT};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $destino_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # La IP del cliente la fija NGINX y descarta la que mande el navegador (C19): la API confía en un solo proxy
        # (trust proxy = 1) y cuenta por IP el límite de las rutas públicas.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # El realm master (la cuenta de administración de Keycloak) no se publica: solo lo usa kcadm.sh por la red interna.
    # Va antes del bloque siguiente porque NGINX toma la primera expresión regular que coincide.
    location ~* ^/auth/realms/master(/|$) {
        return 404;
    }

    # --- Keycloak, bajo /auth: solo lo que usa el navegador (inicio de sesión, tokens y recursos del tema) ---
    location ~ ^/auth/(realms|resources)/ {
        # Esas rutas nunca llevan «%», «;» ni «..». Lo demás se rechaza, para que nada llegue a Keycloak con una forma
        # distinta de la que NGINX comparó.
        if ($ruta_sin_consulta ~ "(%|;|\.\.)") {
            return 404;
        }
        set $destino_keycloak http://keycloak:8080;
        proxy_pass $destino_keycloak;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        # Keycloak responde con cabeceras grandes (cookies de sesión).
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # La consola de administración y la Admin API (/auth/admin), las métricas y la salud no se publican. La API usa la
    # Admin API por la red interna; el equipo administra Keycloak con kcadm.sh dentro del contenedor.
    location /auth/ {
        return 404;
    }

    # --- Frontend: build de Vue ---
    # Los archivos de /assets llevan un hash en el nombre: se pueden guardar en caché sin vencimiento.
    location /assets/ {
        gzip on;
        gzip_types text/css application/javascript;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html no se guarda en caché (así cada despliegue se ve de inmediato) y pide al navegador que no envíe
    # Referer: el enlace de P02 no viaja a otros sitios ni llega a los registros en las peticiones siguientes (C19).
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Referrer-Policy "no-referrer";
    }

    # Las rutas del router de Vue (/portal, /gestion/..., /visita-guiada, /callback/...) devuelven index.html.
    location / {
        try_files $uri /index.html;
    }
}
