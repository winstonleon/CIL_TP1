{
  "name": "cil-admision",
  "private": true,
  "description": "Sistema de tramitación de admisión del CIL (Taller de Proyecto 1, UPC)",
  "engines": {
    "node": "22.23.3"
  },
  "workspaces": [
    "api",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "kc:usuarios-prueba": "node scripts/keycloak-usuarios-prueba.mjs",
    "infra:verificar": "node scripts/verificar-infra.mjs",
    "db:roles": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T postgres sh /docker-entrypoint-initdb.d/02-separar-roles.sh",
    "db:migrate": "node scripts/db.mjs up",
    "db:seed": "npm run seed --workspace api",
    "test:api": "npm run test --workspace api",
    "test:front": "npm run test --workspace frontend",
    "test:e2e": "npm run test --workspace e2e",
    "n8n:importar": "node scripts/importar-workflows.mjs",
    "n8n:credenciales": "node scripts/n8n-credenciales.mjs"
  },
  "devDependencies": {
    "dbmate": "2.36.0"
  }
}
