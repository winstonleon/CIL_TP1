# Copiar a .env (no se versiona). Valores de ejemplo para desarrollo.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=cambiar
ADMISION_DB=admision
ADMISION_DB_USER=api_admision
ADMISION_DB_PASSWORD=cambiar
# Rol de migración: dueño del esquema de admision; lo usan dbmate y las pruebas (S0-B9). La API no lo recibe.
ADMISION_MIGRATOR_USER=admision_migrador
ADMISION_MIGRATOR_PASSWORD=cambiar
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=cambiar
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=cambiar
# Puerto de Postgres en el host (dev). 5432 suele estar ocupado por un Postgres local.
POSTGRES_HOST_PORT=55432

# --- Keycloak ---
# La versión de cada imagen está fijada en docker-compose.yml (no en este archivo).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar
KEYCLOAK_REALM=cil-admision
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080      # debe usar KEYCLOAK_HOST_PORT; en prod: https://<dominio>/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_API_CLIENT_ID=api-admision
KEYCLOAK_API_CLIENT_SECRET=cambiar
# Contraseña de los usuarios ficticios de infra/keycloak/usuarios-prueba.json (solo dev)
KEYCLOAK_TEST_USER_PASSWORD=cambiar

# --- API ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://api:3000
INTERNAL_API_TOKEN=cambiar-token-servicio-n8n
# Cifrado del DNI (ADR-03). 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_HMAC_KEY=

# --- n8n ---
# Puerto de n8n del proyecto en el host (dev). 5678 queda libre para un n8n personal.
N8N_HOST_PORT=5679
N8N_WEBHOOK_INTERNAL_URL=http://n8n:5678/webhook
N8N_WEBHOOK_SECRET=cambiar
N8N_ENCRYPTION_KEY=cambiar
# Para el MCP n8n-mcp y scripts/importar-workflows (se leen del entorno de Windows con setx, no de este archivo).
# Apuntan SOLO al n8n del proyecto:
# N8N_CIL_API_URL=http://localhost:5679
# N8N_CIL_API_KEY=

# --- Frontend ---
FRONTEND_PUBLIC_URL=http://localhost:5173
VITE_API_URL=/api
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/cil-admision
VITE_OIDC_CLIENT_ID_PORTAL=portal-familias
VITE_OIDC_CLIENT_ID_GESTION=gestion-interna

# --- Correo ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Admisión CIL <admision@ejemplo.test>"
MAILPIT_UI_PORT=8025

# --- WhatsApp Cloud API (desactivado hasta tener la cuenta) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Almacenamiento (ADR-12, PENDIENTE) ---
STORAGE_DRIVER=local
