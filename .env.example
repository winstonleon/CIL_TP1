# Copiar a .env (no se versiona). Valores de ejemplo para desarrollo.
# En producción (VPS) se parte de este mismo archivo y se cambian los valores de .env.prod.example.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=cambiar
ADMISION_DB=admision
ADMISION_DB_USER=api_admision
ADMISION_DB_PASSWORD=cambiar
# Rol de migración: dueño del esquema de admision; lo usan dbmate y las pruebas (S0-B9). La API no lo recibe.
ADMISION_MIGRATOR_USER=admision_migrador
ADMISION_MIGRATOR_PASSWORD=cambiar
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=cambiar
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=cambiar
# Puerto de Postgres en el host (dev). 5432 suele estar ocupado por un Postgres local.
POSTGRES_HOST_PORT=55432
# Desde dónde llega `npm run db:migrate` a Postgres (ADR-08). Opcionales. En dev corre en el host: sin definirlas,
# 127.0.0.1 y POSTGRES_HOST_PORT. En producción corre en el contenedor `admin`, dentro de la red interna, y
# docker-compose.prod.yml las fija en postgres:5432 (no se definen en el .env del servidor).
# MIGRACIONES_DB_HOST=127.0.0.1
# MIGRACIONES_DB_PORT=55432

# --- Keycloak ---
# La versión de cada imagen está fijada en docker-compose.yml (no en este archivo).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar
KEYCLOAK_REALM=cil-admision
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080      # debe usar KEYCLOAK_HOST_PORT; en prod: https://<dominio>/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_API_CLIENT_ID=api-admision
KEYCLOAK_API_CLIENT_SECRET=cambiar
# Contraseña de los usuarios ficticios de infra/keycloak/usuarios-prueba.json (solo dev)
KEYCLOAK_TEST_USER_PASSWORD=cambiar

# --- API ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://api:3000
INTERNAL_API_TOKEN=cambiar-token-servicio-n8n
# Cifrado del DNI (ADR-03). 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_HMAC_KEY=
# Enlace para agendar la visita guiada (HU0002, ADR-18): cifra el id del expediente en el enlace de la carpeta.
# 32 bytes en base64 (lo genera node scripts/generar-secretos.js). Rotarla invalida los enlaces ya enviados.
ENLACE_VISITA_KEY=
# Cifrado de los archivos de documentos y comprobantes en reposo (HU0006 y HU0007, ADR-03 y ADR-21). 32 bytes en base64
# (lo genera node scripts/generar-secretos.js). Perderla es perder los archivos: se respalda aparte (C35 y C47).
ARCHIVOS_ENCRYPTION_KEY=
# Solo durante una rotación (C47): la clave anterior, para leer los archivos que aún no se re-cifraron. Vacía normalmente.
ARCHIVOS_ENCRYPTION_KEY_ANTERIOR=
# URL pública de la carpeta informativa digital del colegio (ADR-18). Opcional: vacía, el correo lo dice entre corchetes.
# En dev, la URL ficticia de abajo (decisión de John, 26/10/2026); en el VPS, la real que entregue el colegio (C33).
CARPETA_INFORMATIVA_URL=https://carpeta.ejemplo.test/admision-2027
# Horas de anticipación del recordatorio de la visita guiada (HU0003, D4; ADR-19). Entero de 1 a 168. Obligatoria.
# Provisional hasta que el colegio la confirme (C37).
RECORDATORIO_VISITA_HORAS=24
# Horas mínimas de anticipación para reprogramar una cita de evaluación (HU0009-2.0; ADR-19). Opcional, de 1 a 168;
# sin definir, 24.
# REPROGRAMACION_MIN_HORAS=24
# Plazo máximo de cada etapa con una acción pendiente de la familia, en días corridos (HU0018-2.0, R21; ADR-19).
# Opcionales, de 3 a 90. Provisionales hasta que el colegio los defina; sin definir, estos valores.
# PLAZO_POSTULACION_DIAS=15
# PLAZO_SUBSANACION_DIAS=7
# PLAZO_AGENDAMIENTO_DIAS=7
# PLAZO_REPROGRAMACION_DIAS=7
# PLAZO_CUOTA_DIAS=7
# Dirección del colegio para «Lugar» de P02 y de los correos de la visita (ADR-19). Opcional: vacía, se ve
# «[Dirección del colegio]» hasta que el colegio la entregue (C39).
DIRECCION_COLEGIO=

# Buzón del personal de admisión: recibe el aviso del dictamen «En observación» (HU0010-2.0, ADR-25). Obligatoria:
# sin ella la API no arranca. En dev, una dirección @ejemplo.test (llega a Mailpit).
CORREO_ADMISION=admision@ejemplo.test
# Buzón de Tesorería: recibe el aviso de un comprobante de la cuota de ingreso por conciliar (HU0014-1.0, ADR-26).
# Obligatoria: sin ella la API no arranca. En dev, una dirección @ejemplo.test (llega a Mailpit).
CORREO_TESORERIA=tesoreria@ejemplo.test

# --- Campaña de admisión (HU0022, C23) ---
# Campaña activa (ADR-14): G09 configura los grados, requisitos y horarios de esta campaña, y la muestran la gestión
# interna y el acceso del personal (G01). Se cambia editando este valor en .env.
# Hasta 10 caracteres (grado.campana_admision). La leen api y keycloak: al cambiarla hay que recrear los dos
# contenedores (GUIA-INSTALACION.md). Es obligatoria para la API, db:seed y test:api.
CAMPANA_ACTIVA=2027

# --- n8n ---
# Puerto de n8n del proyecto en el host (dev). 5678 queda libre para un n8n personal.
N8N_HOST_PORT=5679
N8N_WEBHOOK_INTERNAL_URL=http://n8n:5678/webhook
N8N_WEBHOOK_SECRET=cambiar
N8N_ENCRYPTION_KEY=cambiar
# Para el MCP n8n-mcp y scripts/importar-workflows (se leen del entorno de Windows con setx, no de este archivo).
# Apuntan SOLO al n8n del proyecto:
# N8N_CIL_API_URL=http://localhost:5679
# N8N_CIL_API_KEY=

# --- Frontend ---
FRONTEND_PUBLIC_URL=http://localhost:5173
# Puerto del frontend en el host (dev). Opcional, por defecto 5173; debe coincidir con el de FRONTEND_PUBLIC_URL.
FRONTEND_HOST_PORT=5173
VITE_API_URL=/api
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/cil-admision
VITE_OIDC_CLIENT_ID_PORTAL=portal-familias
VITE_OIDC_CLIENT_ID_GESTION=gestion-interna

# --- Correo ---
SMTP_HOST=mailpit
SMTP_PORT=1025
# Autenticación y TLS del SMTP (C12). Las leen n8n (npm run n8n:credenciales) y el realm de Keycloak, que las toma al
# importarse (solo la primera vez: GUIA-INSTALACION.md, sección 10). Sin definirlas rige Mailpit: sin autenticación ni TLS.
# SMTP_SSL es TLS implícito (puerto 465); SMTP_STARTTLS, el que negocia el servidor (587). No pueden ser true a la vez.
# SMTP_USER y SMTP_PASSWORD solo se definen con SMTP_AUTH=true. La contraseña no debe llevar «${».
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=false
SMTP_FROM="Admisión CIL <admision@ejemplo.test>"
# Remitente del correo que envía Keycloak (enlace para definir la contraseña del personal, HU0021).
# Solo la dirección, sin nombre: debe coincidir con la dirección de SMTP_FROM.
KEYCLOAK_SMTP_FROM=admision@ejemplo.test
MAILPIT_UI_PORT=8025

# --- WhatsApp Cloud API (desactivado hasta tener la cuenta) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Almacenamiento (ADR-12 D1 y ADR-21) ---
# Tope técnico provisional de archivos vigentes por requisito en P06 (ADR-19). Opcional, de 1 a 100; sin definir, 20.
# MAX_DOCUMENTOS_POR_REQUISITO=20
# Adaptador de los archivos: solo `local` por ahora (volumen `archivos` de la api; su respaldo es C35).
STORAGE_DRIVER=local
