# Copiar a .env (no se versiona). Valores de ejemplo para desarrollo.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=cambiar
ADMISION_DB=admision
ADMISION_DB_USER=api_admision
ADMISION_DB_PASSWORD=cambiar
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=cambiar
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=cambiar

# --- Keycloak ---
KEYCLOAK_VERSION=x.y.z        # fijar una versión concreta, nunca latest
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar
KEYCLOAK_REALM=cil-admision
KEYCLOAK_PUBLIC_URL=http://localhost:8080      # en prod: https://<dominio>/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_API_CLIENT_ID=api-admision
KEYCLOAK_API_CLIENT_SECRET=cambiar

# --- API ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://api:3000
INTERNAL_API_TOKEN=cambiar-token-servicio-n8n
# Cifrado del DNI (ADR-03). 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_HMAC_KEY=

# --- n8n ---
N8N_VERSION=1.x.x            # fijar una versión concreta, nunca latest
N8N_WEBHOOK_INTERNAL_URL=http://n8n:5678/webhook
N8N_WEBHOOK_SECRET=cambiar
N8N_ENCRYPTION_KEY=cambiar
# Para el MCP n8n-mcp en Claude Code (se leen del entorno de Windows, no de este archivo):
# N8N_API_URL=http://localhost:5678
# N8N_API_KEY=

# --- Frontend ---
VITE_API_URL=/api
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/cil-admision
VITE_OIDC_CLIENT_ID_PORTAL=portal-familias
VITE_OIDC_CLIENT_ID_GESTION=gestion-interna

# --- Correo ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Admisión CIL <admision@ejemplo.test>"

# --- WhatsApp Cloud API (desactivado hasta tener la cuenta) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Almacenamiento (ADR-12, PENDIENTE) ---
STORAGE_DRIVER=local
